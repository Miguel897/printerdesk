<Window x:Class="PrinterDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:PrinterDesk.App.ViewModels"
        xmlns:conv="clr-namespace:PrinterDesk.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PrinterDesk" Height="780" Width="1240" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SavePdfCommand}" />
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding Print.PrintCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumDisplayConverter x:Key="EnumDisplay" />

        <SolidColorBrush x:Key="Accent" Color="#0F6CBD" />
        <SolidColorBrush x:Key="PanelBorder" Color="#E0E0E0" />
        <SolidColorBrush x:Key="Muted" Color="#616161" />

        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemTemplate" Value="{StaticResource EnumItem}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Scanner bar -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Scanner" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Scanners}" SelectedItem="{Binding SelectedScanner}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="&#xE72C;"
                        ToolTip="Search the network for scanners" Command="{Binding DiscoverCommand}" />
                <TextBox Grid.Column="3" Width="150" Margin="16,0,4,0" VerticalContentAlignment="Center"
                         Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Scanner IP address or host name, e.g. 192.168.1.130">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConnectManualCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="4" Content="Connect" Command="{Binding ConnectManualCommand}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Searching…" Foreground="{StaticResource Muted}" Margin="0,0,12,0"
                               Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVisibility}}" />
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#BDBDBD" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#2E9D47" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}" />
                    <Button Style="{StaticResource IconButton}" Margin="12,0,0,0" Content="&#xE946;"
                            ToolTip="About PrinterDesk" AutomationProperties.Name="About PrinterDesk" Command="{Binding ShowAboutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding NewDocumentCommand}" ToolTip="Start a new document">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A5;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding PageCountText}" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}" />
                    <Button Content="Save JPEG…" Command="{Binding SaveJpegCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SavePdfCommand}" ToolTip="Save as PDF (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save PDF…" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;" Foreground="#2E9D47" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SavedMessage}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkButton}" Content="Open file" Command="{Binding OpenSavedFileCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Open folder" Command="{Binding OpenSavedFolderCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Scan and print panel -->
            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                <TabControl BorderThickness="0,1,0,0" Padding="0" Margin="0,8,0,0">
                <TabItem Header="Scan" Padding="14,4" AutomationProperties.Name="Scan">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,14">
                <StackPanel>
                    <TextBlock Text="Source" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" IsEnabled="{Binding IsConnected}" />

                    <TextBlock Text="Resolution" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedDpi}" IsEnabled="{Binding IsConnected}" />

                    <TextBlock Text="Color" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColor}" IsEnabled="{Binding IsConnected}" />

                    <TextBlock Text="Paper size (flatbed)" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper}" IsEnabled="{Binding IsConnected}" />

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" MinHeight="38" Command="{Binding ScanCommand}" ToolTip="Scan and add pages (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8FE;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Scan" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,8,0,0" Command="{Binding ScanDuplexCommand}"
                            Content="Two-sided (manual)…"
                            ToolTip="Scan the fronts from the feeder, flip the stack, scan the backs. Pages are put in order automatically." />
                    <Button Margin="0,8,0,0" Command="{Binding CancelScanCommand}" Content="Cancel"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                    <ProgressBar Height="4" Margin="0,16,0,0" IsIndeterminate="{Binding IsScanning}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <TabItem Header="Print" Padding="14,4" AutomationProperties.Name="Print">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,14">
                <StackPanel DataContext="{Binding Print}">
                    <TextBlock Text="{Binding PrinterStatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding InkText}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInkLow}" Value="True">
                                        <Setter Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Copies" Style="{StaticResource Label}" />
                            <TextBox Height="28" VerticalContentAlignment="Center" AutomationProperties.Name="Copies"
                                     Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pages" Style="{StaticResource Label}" />
                            <TextBox Height="28" VerticalContentAlignment="Center" AutomationProperties.Name="Pages"
                                     Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}"
                                     ToolTip="Empty prints all pages. Example: 1-3, 5" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Color" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColor}" IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="Print color" />

                    <TextBlock Text="Sides" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding SidesOptions}" SelectedItem="{Binding SelectedSides}" IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="Sides" />

                    <TextBlock Text="Orientation" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="Orientation" />

                    <TextBlock Text="Paper" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding MediaSizes}" SelectedItem="{Binding SelectedMedia}" IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="Paper" />

                    <TextBlock Text="Quality" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="Quality" />

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" MinHeight="38" Command="{Binding PrintCommand}" ToolTip="Print the document (Ctrl+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE749;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Print" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Margin="0,8,0,0" Command="{Binding CancelPrintCommand}" Content="Cancel"
                            Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}" />

                    <ProgressBar Height="4" Margin="0,16,0,0" IsIndeterminate="{Binding IsPrinting}"
                                 Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                </ScrollViewer>
                </TabItem>
                </TabControl>
            </Border>

            <!-- Pages -->
            <Border Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Background="#FAFAFA">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PAGES" Style="{StaticResource SectionTitle}" Margin="14,14,0,4" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,10">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up" Command="{Binding MoveUpCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down" Command="{Binding MoveDownCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Rotate left" Command="{Binding RotateLeftCommand}"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Button.RenderTransform>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Rotate right" Command="{Binding RotateRightCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete selected pages (Del)"
                                Command="{Binding DeletePagesCommand}" CommandParameter="{Binding SelectedItems, ElementName=PageList}" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="No pages yet.&#x0a;Click Scan to start." TextAlignment="Center" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                                 SelectionMode="Extended" AllowDrop="True" Background="#FAFAFA" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}"
                                 PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PageList_PreviewMouseMove"
                                 Drop="PageList_Drop">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeletePagesCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=PageList}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="Margin" Value="8,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <StackPanel>
                                        <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="White" HorizontalAlignment="Center">
                                            <Image Source="{Binding Thumbnail}" MaxWidth="130" MaxHeight="130" Stretch="Uniform">
                                                <Image.LayoutTransform>
                                                    <RotateTransform Angle="{Binding Rotation}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Border>
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <Grid Grid.Column="2" Background="#EDEDED">
                <TextBlock x:Name="PreviewPlaceholder" Text="The PDF preview will appear here." Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24" />
                <wv2:WebView2 x:Name="Preview" Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
