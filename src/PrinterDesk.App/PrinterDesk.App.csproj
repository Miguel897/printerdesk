<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PrinterDesk.Core\PrinterDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PrinterDesk</AssemblyName>
    <ApplicationIcon>Assets\PrinterDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon for the About dialog; window title bars use the exe icon (ApplicationIcon). -->
    <Resource Include="Assets\PrinterDesk.ico" />
    <!-- Required by the bundled components' licenses; shown in About › Third-party notices. -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- dotnet publish src/PrinterDesk.App -c Release -r win-x64  =>  one self-contained PrinterDesk.exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Only the exe: no .pdb/.xml from referenced projects and packages. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- The single-file analyzer pulls in an implicit ILLink package that would break the locked restore. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>
